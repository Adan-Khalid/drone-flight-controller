# (hardware/gen/footprints.py), not redistributed
hardware/kicad/lib/dronefc.3dshapes/
*-backups/
*.kicad_prl
fp-info-cache
*.lck
_autosave-*

# Altium local files
History/
__Previews/
Project Logs for */
*.PrjPcbStructure

# KiCad simulator scratch outputs
sim/**/*.raw
sim/**/*.log

# ArduPilot build outputs (the board definition lives in firmware/hwdef/)
firmware/build/

# Flight logs stay local until reviewed (see data/README.md)
data/raw/

# Local secrets
.env

# ArduPilot sources fetched by scripts/check_hwdef.py
.cache/

# The board layout is not finished (see README); the placed board is regenerated by
# hardware/gen/build_board.py and kept out of the repo until routing is done
hardware/kicad/dronefc.kicad_pcb
hardware/kicad/*.kicad_dru
fab/
