# SPDX-License-Identifier: GPL-3.0-or-later
# ArduPilot hardware definition for DroneFC-H743, a 36 x 36 mm STM32H743VIT6 flight controller.
#
# Pin and timer map derived from ArduPilot's MatekH743 and MatekH743-bdshot board files
# (same processor and package, flying with ArduPilot), changed for this board's sensors.
#
# DRAFT, written before the schematic: every pin is checked in STM32CubeMX and against the
# KiCad schematic, and the ArduPilot build checks the DMA allocation, before boards are ordered.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# Board ID: a number is reserved through a pull request to Tools/AP_Bootloader/board_types.txt
# before the first build (see firmware/hwdef/README.md).
APJ_BOARD_ID AP_HW_DRONEFC_H743

# 8 MHz crystal, as ArduPilot expects (8 or 24 MHz)
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader takes the first 128 KB sector
FLASH_RESERVE_START_KB 128

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB (USB-C connector)
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD debug pads
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1: IMU1, TDK ICM-45686
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PC15 IMU1_CS CS

# SPI4: IMU2, Bosch BMI088 (separate chip selects for accelerometer and gyroscope)
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4
PE11 BMI088_A_CS CS
PC13 BMI088_G_CS CS

# I2C: bus 0 = I2C2 (on board: DPS368 barometer), bus 1 = I2C1 (external: GPS compass)
I2C_ORDER I2C2 I2C1

PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# ADC: battery voltage through the 150 k / 10 k divider (ratio 16.0) and the ESC current sensor
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 16.0
# placeholder until the ESC is chosen: set to that ESC's current-sensor scale (A per V)
define HAL_BATT_CURR_SCALE 40.0

# LEDs
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE3 LED0 OUTPUT LOW GPIO(90)
PE4 LED1 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# order of UARTs (and USB)
SERIAL_ORDER OTG1 UART7 USART1 USART2 USART3 UART8 UART4 USART6 OTG2

# UART7 = SERIAL1: TELEM1 with flow control (JST GH, Pixhawk DS-009 pinout)
PE7 UART7_RX UART7
PE8 UART7_TX UART7
PE10 UART7_CTS UART7
PE9 UART7_RTS UART7

# USART1 = SERIAL2: TELEM2 or companion computer
PA10 USART1_RX USART1
PA9 USART1_TX USART1

# USART2 = SERIAL3: GPS1 (I2C1 for its compass is on the same connector)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# USART3 = SERIAL4: GPS2 or spare
PD9 USART3_RX USART3
PD8 USART3_TX USART3

# UART8 = SERIAL5: ESC telemetry (on the 4-in-1 ESC connector)
PE0 UART8_RX UART8 NODMA
PE1 UART8_TX UART8 NODMA

# UART4 = SERIAL6: spare
PB9 UART4_TX UART4 NODMA
PB8 UART4_RX UART4 NODMA

# USART6 = SERIAL7: RC input as a UART (CRSF/ELRS or SBUS), see defaults.parm
PC7 USART6_RX USART6
PC6 USART6_TX USART6

# Motor outputs with bidirectional DShot (timer and pin map of MatekH743-bdshot).
# Outputs 1 to 4 go to the 4-in-1 ESC connector (a quadcopter needs no more).
PB0  TIM3_CH3 TIM3 PWM(1) GPIO(50) BIDIR
PB1  TIM3_CH4 TIM3 PWM(2) GPIO(51)
PA0  TIM2_CH1 TIM2 PWM(3) GPIO(52) BIDIR
PA1  TIM2_CH2 TIM2 PWM(4) GPIO(53)

# serial LED (WS2812) pad
PA8 TIM1_CH1 TIM1 PWM(5) GPIO(62)

# microSD on SDMMC1 (4-bit)
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

define HAL_OS_FATFS_IO 1

# DMA: the IMU buses and the motor timers each get their own streams
DMA_PRIORITY SPI1* SPI4*
DMA_NOSHARE SPI1* SPI4* TIM3* TIM2*

# parameter storage in the last two 128 KB flash pages
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# SPI devices (speeds as used for the same sensors on ArduPilot's Pixhawk6X)
SPIDEV icm45686 SPI1 DEVID1 IMU1_CS     MODE3  2*MHZ  8*MHZ
SPIDEV bmi088_g SPI4 DEVID1 BMI088_G_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_a SPI4 DEVID2 BMI088_A_CS MODE3 10*MHZ 10*MHZ

# IMUs: rotations are set after the layout fixes each sensor's orientation
IMU Invensensev3 SPI:icm45686 ROTATION_NONE
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_NONE
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# barometer: Infineon DPS368 uses ArduPilot's DPS310 driver; address set by its SDO pin
BARO DPS310 I2C:0:0x76

# no compass on the board; probe the I2C buses for an external one
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# build ABIN for flash-from-bootloader support
env BUILD_ABIN True
